    productos_agrupados=list(sorted(productos, key=lambda pro:(pro["categoria"],-pro["precio"], pro["stock"])))
    return productos_agrupados

def ordenar_categoria(productos_agrupados):
    orden_categorico ={categoria:list(productos_categoria)for categoria,productos_categoria in groupby(productos_agrupados,key=lambda e:e["categoria"])}
    return orden_categorico


